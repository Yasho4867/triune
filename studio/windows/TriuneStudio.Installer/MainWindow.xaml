<Window x:Class="TriuneStudio.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Triune Studio Setup — AI Engine, Research IDE &amp; CLI Installer"
        Height="720" Width="920" MinHeight="640" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource InstallerBackground}"
        Foreground="{StaticResource InstallerForeground}"
        Closing="Window_Closing">
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <Border Grid.Row="0" Background="{StaticResource InstallerSurface}" BorderBrush="{StaticResource InstallerBorder}" BorderThickness="1" CornerRadius="10" Padding="20,16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Width="46" Height="46" CornerRadius="10" Background="#4338CA" VerticalAlignment="Center" Margin="0,0,16,0">
          <TextBlock Text="T" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="TRIUNE STUDIO &amp; AI ENGINE SETUP" FontSize="19" FontWeight="Bold" Foreground="{StaticResource InstallerForeground}" />
          <TextBlock x:Name="WorkspacePathText" Text="Provisioning local Mixture-of-Experts IDE, PyTorch CUDA Engine, and Unified CLI" FontSize="12.5" Foreground="{StaticResource InstallerMuted}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Border Grid.Column="2" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Padding="10,5" VerticalAlignment="Center">
          <TextBlock x:Name="GpuBadgeText" Text="Probing Hardware..." FontSize="12" FontWeight="SemiBold" Foreground="#38BDF8" />
        </Border>
      </Grid>
    </Border>

    <!-- Configuration & Hardware Summary -->
    <Grid Grid.Row="1" Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.1*" />
        <ColumnDefinition Width="0.9*" />
      </Grid.ColumnDefinitions>

      <!-- Left: Hardware & Environment Options -->
      <Border Grid.Column="0" Background="{StaticResource InstallerSurface}" BorderBrush="{StaticResource InstallerBorder}" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,0,8,0">
        <StackPanel>
          <TextBlock Text="INSTALLATION &amp; ACCELERATION OPTIONS" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource InstallerMuted}" />
          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Compute Target:" VerticalAlignment="Center" Foreground="#D1D5DB" FontSize="13" Margin="0,0,12,0" />
            <ComboBox x:Name="CudaComboBox" Grid.Column="1" SelectedIndex="0" Padding="8,5" FontSize="12.5">
              <ComboBoxItem Content="Auto-Detect Optimal CUDA / Tensor Core Wheel (Recommended)" Tag="auto" />
              <ComboBoxItem Content="NVIDIA CUDA 13.2 (Blackwell / RTX 50-Series / Python 3.14)" Tag="13.2" />
              <ComboBoxItem Content="NVIDIA CUDA 12.6 (Ada / Hopper / Ampere)" Tag="12.6" />
              <ComboBoxItem Content="NVIDIA CUDA 12.4 (Standard CUDA)" Tag="12.4" />
              <ComboBoxItem Content="CPU Only (Fallback Execution)" Tag="cpu" />
            </ComboBox>
          </Grid>

          <CheckBox x:Name="DesktopShortcutCheck" Content="Create Windows Desktop &amp; Start Menu shortcuts (TriuneStudio.exe)" IsChecked="True" Foreground="#E5E7EB" FontSize="12.5" Margin="0,12,0,0" />
          <CheckBox x:Name="RegisterPathCheck" Content="Register unified 'triune' CLI on Windows User PATH" IsChecked="True" Foreground="#E5E7EB" FontSize="12.5" Margin="0,8,0,0" />
          <CheckBox x:Name="SkipTorchCheck" Content="Fast repair mode (keep existing PyTorch wheel if already verified)" IsChecked="False" Foreground="#E5E7EB" FontSize="12.5" Margin="0,8,0,0" />
        </StackPanel>
      </Border>

      <!-- Right: 6-Stage Pipeline Tracker -->
      <Border Grid.Column="1" Background="{StaticResource InstallerSurface}" BorderBrush="{StaticResource InstallerBorder}" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="8,0,0,0">
        <StackPanel>
          <TextBlock Text="PROVISIONING PIPELINE STAGES" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource InstallerMuted}" />
          <TextBlock x:Name="Stage1Text" Text="○  [1/6] Hardware Stack &amp; Driver Probing" FontSize="12.5" Foreground="#9CA3AF" Margin="0,8,0,0" />
          <TextBlock x:Name="Stage2Text" Text="○  [2/6] Isolated Studio Virtual Environment" FontSize="12.5" Foreground="#9CA3AF" Margin="0,4,0,0" />
          <TextBlock x:Name="Stage3Text" Text="○  [3/6] PyTorch &amp; CUDA Tensor Core Runtime" FontSize="12.5" Foreground="#9CA3AF" Margin="0,4,0,0" />
          <TextBlock x:Name="Stage4Text" Text="○  [4/6] Studio API, WebSockets &amp; Triune Engine" FontSize="12.5" Foreground="#9CA3AF" Margin="0,4,0,0" />
          <TextBlock x:Name="Stage5Text" Text="○  [5/6] Native Shortcuts &amp; Global CLI PATH" FontSize="12.5" Foreground="#9CA3AF" Margin="0,4,0,0" />
          <TextBlock x:Name="Stage6Text" Text="○  [6/6] End-to-End Subsystem Health Check" FontSize="12.5" Foreground="#9CA3AF" Margin="0,4,0,0" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- Live Progress & Streaming Console -->
    <Border Grid.Row="2" Background="#0B0D11" BorderBrush="{StaticResource InstallerBorder}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,16,0,0">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="StatusHeadlineText" Text="Ready to install or repair Triune Studio." FontSize="13.5" FontWeight="SemiBold" Foreground="#F3F4F6" />
          <TextBlock x:Name="PercentText" Grid.Column="1" Text="0%" FontSize="13" FontWeight="Bold" Foreground="#38BDF8" />
        </Grid>
        <ProgressBar x:Name="InstallProgressBar" Grid.Row="1" Minimum="0" Maximum="100" Value="0" Height="6" Margin="0,10,0,12" Background="#1F2937" Foreground="#38BDF8" BorderThickness="0" />
        <TextBox x:Name="ConsoleOutputBox" Grid.Row="2" Background="#07090C" Foreground="#D1D5DB" BorderBrush="#1F2937" BorderThickness="1"
                 FontFamily="Consolas" FontSize="12" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap" Padding="10" />
      </Grid>
    </Border>

    <!-- Footer Action Bar -->
    <Grid Grid.Row="3" Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="FooterHintText" Grid.Column="0" Text="Native Windows WPF Host + WebView2 + Python/CUDA Engine" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource InstallerMuted}" />
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="ShortcutButton" Content="Create Desktop Shortcut" Padding="14,9" Margin="0,0,10,0" Background="#1E293B" Foreground="#38BDF8" BorderBrush="#334155" Click="ShortcutButton_Click" />
        <Button x:Name="VerifyButton" Content="Verify Health Only" Padding="16,9" Margin="0,0,10,0" Background="#1F2937" Foreground="#F3F4F6" BorderBrush="#374151" Click="VerifyButton_Click" />
        <Button x:Name="InstallButton" Content="Install / Repair Studio" Padding="20,9" Margin="0,0,10,0" Background="#C2410C" Foreground="White" FontWeight="SemiBold" BorderBrush="#EA580C" Click="InstallButton_Click" />
        <Button x:Name="LaunchStudioButton" Content="Launch Triune Studio →" Padding="20,9" Background="#059669" Foreground="White" FontWeight="SemiBold" BorderBrush="#10B981" IsEnabled="False" Click="LaunchStudioButton_Click" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
