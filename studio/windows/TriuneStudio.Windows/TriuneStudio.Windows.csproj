<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\triune.ico</ApplicationIcon>
    <AssemblyName>TriuneStudio</AssemblyName>
    <Version>2.1.0</Version>
    <Product>Triune Studio</Product>
    <Company>Triune AI</Company>
    <Authors>Triune AI</Authors>
    <Description>Triune Studio - Triune AI engine and research IDE</Description>
    <Copyright>Copyright (c) Triune AI</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <RootNamespace>TriuneStudio.Windows</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="..\triune.ico" Link="triune.ico" />
    <Content Include="triune_core.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('triune_core.dll')" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>
</Project>
