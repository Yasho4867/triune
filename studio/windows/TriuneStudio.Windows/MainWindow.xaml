<Window x:Class="TriuneStudio.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Triune Studio" Height="900" Width="1440" MinHeight="640" MinWidth="960"
        Icon="triune.ico"
        Background="{StaticResource StudioBackground}" Foreground="{StaticResource StudioForeground}"
        Closing="Window_Closing">
  <Grid>
    <wv2:WebView2 x:Name="StudioView" Visibility="Collapsed" />
    <Border x:Name="StartupPanel" Background="{StaticResource StudioBackground}" Padding="36">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
        <TextBlock Text="TRIUNE STUDIO" Foreground="{StaticResource StudioForeground}"
                   FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" />
        <TextBlock x:Name="StatusText" Text="Starting the local model engine…" Margin="0,14,0,0"
                   Foreground="#C9CDD4" FontSize="15" TextAlignment="Center" TextWrapping="Wrap" />
        <ProgressBar x:Name="StartupProgress" IsIndeterminate="True" Height="4" Margin="0,24,0,0"
                     Background="#30343B" Foreground="{StaticResource StudioAccent}" />
        <Button x:Name="RetryButton" Content="Try again" Visibility="Collapsed" Margin="0,22,0,0"
                Padding="16,8" HorizontalAlignment="Center" Click="RetryButton_Click" />
        <Button x:Name="SetupButton" Content="Install / repair Studio environment" Visibility="Collapsed" Margin="0,8,0,0"
                Padding="16,8" HorizontalAlignment="Center" Click="SetupButton_Click" />
        <Button x:Name="OpenLogsButton" Content="Open startup log" Visibility="Collapsed" Margin="0,8,0,0"
                Padding="16,8" HorizontalAlignment="Center" Click="OpenLogsButton_Click" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
