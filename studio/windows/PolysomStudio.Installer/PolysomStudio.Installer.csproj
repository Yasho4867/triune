<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <SelfContained>true</SelfContained>
    <PublishSingleFile Condition="'$(PublishSingleFile)' == ''">false</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\polysom.ico</ApplicationIcon>
    <AssemblyName>PolysomStudioSetup</AssemblyName>
    <Version>1.0.0</Version>
    <Product>Polysom Studio</Product>
    <Company>Lucid Machines</Company>
    <Authors>Lucid Machines (contact@lucidmachines.co)</Authors>
    <PackageProjectUrl>https://lucidmachines.co</PackageProjectUrl>
    <Description>Polysom Studio Setup - Lucid Machines Triune research IDE</Description>
    <Copyright>Copyright (c) Lucid Machines</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <RootNamespace>PolysomStudio.Installer</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="..\polysom.ico" Link="polysom.ico" />
  </ItemGroup>
</Project>
