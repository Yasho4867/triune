<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\polysom.ico</ApplicationIcon>
    <AssemblyName>PolysomStudio</AssemblyName>
    <Version>1.0.0</Version>
    <Product>Polysom Studio</Product>
    <Company>Lucid Machines</Company>
    <Authors>Lucid Machines</Authors>
    <Description>Polysom Studio - Lucid Machines Triune research IDE</Description>
    <Copyright>Copyright (c) Lucid Machines</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <RootNamespace>PolysomStudio.Windows</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="..\polysom.ico" Link="polysom.ico" />
    <Content Include="lucid_machines_core.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('lucid_machines_core.dll')" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>
</Project>
